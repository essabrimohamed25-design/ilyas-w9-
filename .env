# Bot Configuration
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
OWNER_ID=YOUR_DISCORD_USER_ID_HERE
CLIENT_ID=YOUR_BOT_CLIENT_ID_HERE

# Logging Webhooks
LOG_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# Protection Settings
MAX_WARNINGS=5
RAID_JOIN_LIMIT=5
RAID_JOIN_TIME=10
SPAM_LIMIT=5
SPAM_TIME_SECONDS=5
MASS_MENTION_LIMIT=5
LINK_TIMEOUT_MINUTES=5
MAX_CHANNEL_CREATE_LIMIT=5
MAX_CHANNEL_DELETE_LIMIT=5
MAX_ROLE_CREATE_LIMIT=5
MAX_ROLE_DELETE_LIMIT=5
MAX_WEBHOOK_CREATE_LIMIT=3

# Anti-Link Settings
BLOCK_ALL_LINKS=true
ALLOWED_DOMAINS=discord.com,github.com,youtube.com
BLOCKED_DOMAINS=bit.ly,tinyurl.com,dis.gd

# Auto-Mod Settings
AUTO_MODERATION=true
FILTER_BAD_WORDS=true
FILTER_INVITES=true
FILTER_SCAM_LINKS=true
